}
.project-grid .workspace-card.card-vextaro:hover .card-tags span:first-child,
.sx-projects .workspace-card.card-vextaro:hover .card-tags span:first-child {
  background: rgba(90, 163, 201, 0.24) !important;
  border-color: #5aa3c9 !important;
  color: #ffffff !important;
}

/* 4. Honda: Coral (#e27d5a) */
.project-grid .workspace-card.card-honda:hover,
.sx-projects .workspace-card.card-honda:hover {
  border-color: #e27d5a !important;
  box-shadow: 0 8px 28px -4px rgba(226, 125, 90, 0.32) !important;
}
.project-grid .workspace-card.card-honda:hover .card-role,
.project-grid .workspace-card.card-honda:hover .card-outcome b {
  color: #e27d5a !important;
}
.project-grid .workspace-card.card-honda:hover .card-tags span,
.sx-projects .workspace-card.card-honda:hover .card-tags span {
  background: rgba(226, 125, 90, 0.12) !important;
  border-color: rgba(226, 125, 90, 0.45) !important;
  color: #f7ded6 !important;
}
.project-grid .workspace-card.card-honda:hover .card-tags span:first-child,
.sx-projects .workspace-card.card-honda:hover .card-tags span:first-child {
  background: rgba(226, 125, 90, 0.24) !important;
  border-color: #e27d5a !important;
  color: #ffffff !important;
}

/* 5. DevTective: Violet (#9c8be8) */
.project-grid .workspace-card.card-devtective:hover,
.sx-projects .workspace-card.card-devtective:hover {
  border-color: #9c8be8 !important;
  box-shadow: 0 8px 28px -4px rgba(156, 139, 232, 0.32) !important;
}
.project-grid .workspace-card.card-devtective:hover .card-role,
.project-grid .workspace-card.card-devtective:hover .card-outcome b {
  color: #9c8be8 !important;
}
.project-grid .workspace-card.card-devtective:hover .card-tags span,
.sx-projects .workspace-card.card-devtective:hover .card-tags span {
  background: rgba(156, 139, 232, 0.12) !important;
  border-color: rgba(156, 139, 232, 0.45) !important;
  color: #dedaf7 !important;
}
.project-grid .workspace-card.card-devtective:hover .card-tags span:first-child,
.sx-projects .workspace-card.card-devtective:hover .card-tags span:first-child {
  background: rgba(156, 139, 232, 0.24) !important;
  border-color: #9c8be8 !important;
  color: #ffffff !important;
