/* ------------------------------------------------------------
   CASE STUDY PAGES: UNIVERSAL ACCENT COLOR THEME
   All white/gold elements adapt to the specific case study accent:
   Vextaro -> Blue (#5aa3c9)
   Study Buddy -> Purple (#a594f9)
   Honda -> Coral (#e27d5a)
   DevTective -> Violet (#9c8be8)
   SecureID -> Gold (#d9ac54)
   ------------------------------------------------------------ */
.sx-case {
  --gold: var(--accent);
  --gold-bright: var(--accent);
  --gold-dim: color-mix(in srgb, var(--accent) 55%, transparent);
}

/* Nav on case study page */
.sx-case .sx-nav a.is-active,
.sx-case .sx-nav .sx-back-link {
  color: var(--accent) !important;
  background: color-mix(in srgb, var(--accent) 16%, transparent) !important;
}
.sx-case .sx-nav a:hover {
  color: var(--accent) !important;
}

/* Breadcrumbs & headings */
.sx-case .breadcrumb a:hover {
  color: var(--accent) !important;
}
.sx-case .cs-section > h2::before,
.sx-case .cs-split-text > h2::before {
  color: var(--accent) !important;
}

/* Impact stats & metadata */
.sx-case .impact-stat .n {
  color: var(--accent) !important;
}
.sx-case .cs-meta dt {
  color: var(--accent) !important;
}

/* Reasoning chain steps */
.sx-case .chain-step .k {
  color: var(--accent) !important;
}
.sx-case .chain-step .v b {
  color: var(--accent) !important;
}

/* Badges (View Figma Prototype, etc.) with Motion whileHover & whileTap */
.sx-case .cs-badge-row a span {
  border-color: var(--accent) !important;
  color: var(--accent) !important;
  transition: transform 0.24s var(--ease-motion),
              background-color 0.24s var(--ease-motion),
              box-shadow 0.24s var(--ease-motion),
              color 0.24s var(--ease-motion);
}
.sx-case .cs-badge-row a:hover span {
  background: color-mix(in srgb, var(--accent) 22%, transparent) !important;
  box-shadow: 0 4px 18px -2px color-mix(in srgb, var(--accent) 45%, transparent) !important;
  color: #ffffff !important;
  transform: translateY(-2px);
}
.sx-case .cs-badge-row a:active span {
  transform: translateY(0) scale(0.97);
}

/* Buttons */
.sx-case .sx-btn {
  border-color: var(--accent) !important;
  color: var(--accent) !important;
  transition: transform 0.24s var(--ease-motion),
              background-color 0.24s var(--ease-motion),
              box-shadow 0.24s var(--ease-motion),
              color 0.24s var(--ease-motion);
}
.sx-case .sx-btn:hover,
.sx-case .sx-btn:focus-visible {
  border-color: var(--accent) !important;
  color: #ffffff !important;
  background: color-mix(in srgb, var(--accent) 22%, transparent) !important;
  box-shadow: 0 6px 18px color-mix(in srgb, var(--accent) 45%, transparent) !important;
  transform: translateY(-2px);
}
.sx-case .sx-btn:active {
  transform: translateY(0) scale(0.97);
}
.sx-case .sx-btn-primary {
  background: var(--accent) !important;
  border-color: var(--accent) !important;
  color: #080808 !important;
}
.sx-case .sx-btn-primary:hover {
  background: color-mix(in srgb, var(--accent) 85%, #ffffff) !important;
  color: #080808 !important;
  transform: translateY(-2px);
}

/* Footer next/prev navigation */
.sx-case .cs-nav-footer a {
  transition: transform 0.24s var(--ease-motion),
              border-color 0.24s var(--ease-motion),
              box-shadow 0.24s var(--ease-motion),
              color 0.24s var(--ease-motion);
}
.sx-case .cs-nav-footer a:hover {
  border-color: var(--accent) !important;
  color: var(--accent) !important;
  box-shadow: 0 4px 16px color-mix(in srgb, var(--accent) 30%, transparent) !important;
  transform: translateY(-2px);
}
.sx-case .cs-nav-footer a:active {
  transform: translateY(0) scale(0.98);
}

/* ------------------------------------------------------------
   FLOATING OUTLINE RAIL (Desktop Navigation Dots)
   ------------------------------------------------------------ */
.sx-rail {
  position: fixed;
  right: 18px;
  top: 50%;
  transform: translateY(-50%);
  z-index: 90;
  display: none;
  flex-direction: column;
  gap: 8px;
  touch-action: none;
  user-select: none;
}
@media (min-width: 900px) {
  .sx-rail {
    display: flex !important;
  }
}
.sx-rail a {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 18px;
  height: 18px;
  cursor: pointer;
}
.sx-rail a::before {
  content: "";
  position: absolute;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--border, #333);
  transition: background-color 0.25s var(--ease-motion),
              transform 0.25s var(--ease-motion),
              box-shadow 0.25s var(--ease-motion);
}
.sx-rail a:hover::before,
.sx-rail a.is-active::before {
  background: var(--accent) !important;
  transform: scale(1.6);
  box-shadow: 0 0 10px var(--accent) !important;
}
.sx-rail a span {
  position: absolute;
  right: 24px;
  top: 50%;
  transform: translateY(-50%);
  padding: 5px 11px;
  border-radius: 6px;
  background: rgba(18, 15, 11, 0.95);
  border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.7);
  font: 500 12px/1.2 'Inter', sans-serif;
  color: var(--text, #f0ede8);
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s var(--ease-motion),
              transform 0.2s var(--ease-motion);
}
.sx-rail a.is-active span,
.sx-rail a:hover span,
.sx-rail a:focus-visible span {
  opacity: 1;
  transform: translateY(-50%) translateX(-3px);
}

/* Lightbox */
.sx-lightbox { position: fixed; inset: 0; z-index: 1000; background: rgba(8,8,8,0.92); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); display: flex; align-items: center; justify-content: center; padding: 24px; opacity: 0; pointer-events: none; transition: opacity 0.25s ease; cursor: zoom-out; }
.sx-lightbox.is-open { opacity: 1; pointer-events: auto; }
.sx-lightbox img { max-width: 94vw; max-height: 90vh; object-fit: contain; border-radius: 8px; border: 1px solid rgba(255,255,255,0.12); box-shadow: 0 24px 60px -12px rgba(0,0,0,0.9); transform: scale(0.96); transition: transform 0.25s ease; }
.sx-lightbox.is-open img { transform: scale(1); }
.sx-lightbox-close { position: absolute; top: 20px; right: 24px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); color: #fff; border-radius: 50%; width: 36px; height: 36px; display: grid; place-items: center; font-size: 18px; cursor: pointer; }
.sx-lightbox-close:hover { background: rgba(255,255,255,0.2); }
