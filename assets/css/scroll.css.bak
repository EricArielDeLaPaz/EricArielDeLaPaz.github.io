/* ============================================================
   Scrolling portfolio layer (home + case studies)
   Uses the tokens from style.css: --bg, --gold, --text, accents.
   ============================================================ */
html{ scroll-behavior:smooth; scroll-padding-top:96px; }
@media (prefers-reduced-motion:reduce){ html{ scroll-behavior:auto; } }
.sx-page{ height:auto; overflow:visible; min-height:100vh; padding-bottom:0; }
.sx-wrap{ width:100%; max-width:1180px; margin:0 auto; padding:0 32px; }
.sx-skip{ position:absolute; left:-999px; top:8px; z-index:200; padding:8px 14px; background:var(--gold); color:#1a1408; border-radius:6px; font-weight:600; }
.sx-skip:focus{ left:12px; }

/* ---------- Floating frosted pill nav ---------- */
.sx-nav-wrap{ position:fixed; top:14px; left:0; right:0; z-index:100; display:flex; justify-content:center; padding:0 12px; pointer-events:none; }
.sx-nav{ pointer-events:auto; display:flex; align-items:center; gap:4px; padding:6px 10px 6px 8px; border:1px solid rgba(217,172,84,.22); border-radius:999px;
  background:rgba(18,15,11,.55); -webkit-backdrop-filter:blur(18px) saturate(150%); backdrop-filter:blur(18px) saturate(150%);
  box-shadow:0 10px 40px -12px rgba(0,0,0,.7), 0 1px 0 rgba(255,255,255,.05) inset; }
.sx-nav a{ padding:8px 14px; border-radius:999px; font-size:14px; font-weight:500; color:var(--text-dim); transition:background-color .18s ease,color .18s ease; white-space:nowrap; }
.sx-nav a:hover,.sx-nav a:focus-visible{ color:var(--text); background:rgba(255,255,255,.07); }
.sx-nav a.is-active{ color:var(--gold-bright); background:rgba(217,172,84,.14); }
.sx-nav .sx-brand{ display:flex; align-items:center; gap:9px; padding:3px 12px 3px 3px; color:var(--text); font-family:Cinzel,Georgia,serif; font-size:17px; font-weight:600; }
.sx-brand img{ width:28px; height:28px; border-radius:50%; object-fit:cover; border:1px solid var(--gold-dim); }
.sx-nav-sep{ width:1px; height:18px; background:rgba(255,255,255,.12); margin:0 4px; }
.sx-status{ display:flex; align-items:center; gap:8px; padding:0 8px 0 6px; font-size:12.5px; color:var(--text-dim); white-space:nowrap; }
.sx-dot{ position:relative; display:inline-block; width:8px; height:8px; border-radius:50%; background:var(--ok); flex:none; }
.sx-dot::after{ content:""; position:absolute; inset:-4px; border-radius:50%; border:1.5px solid var(--ok); opacity:0; animation:sx-radar 2.2s ease-out infinite; }
@keyframes sx-radar{ 0%{ transform:scale(.5); opacity:.8; } 100%{ transform:scale(1.5); opacity:0; } }
@media (prefers-reduced-motion:reduce){ .sx-dot::after{ animation:none; } }
.sx-back-link{ color:var(--gold-bright)!important; }

/* ---------- Shared type ---------- */
.sx-kicker{ display:flex; align-items:center; gap:10px; margin:0 0 14px; font:600 12px/1 'Inter',sans-serif; letter-spacing:.16em; text-transform:uppercase; color:var(--gold); }
.sx-section .sx-wrap > h2,.sx-about h2,.sx-hero h1{ font-family:Cinzel,Georgia,serif; font-weight:600; color:#f0ede8; letter-spacing:.01em; }
.sx-section .sx-wrap > h2,.sx-about h2{ font-size:clamp(26px,3.4vw,40px); line-height:1.2; max-width:24ch; }
.sx-sub{ max-width:62ch; margin:16px 0 0; font-size:18px; line-height:1.65; color:var(--text-dim); }
.sx-section{ padding:92px 0; border-top:1px solid var(--border-soft); }
.sx-group{ margin:44px 0 16px; font:600 13px/1 'Inter',sans-serif; letter-spacing:.14em; text-transform:uppercase; color:var(--text-faint); }
.sx-group:first-of-type{ margin-top:36px; }

/* ---------- Buttons ---------- */
.sx-cta{ display:flex; flex-wrap:wrap; gap:12px; margin-top:28px; }

/* ---------- Hero ---------- */
.sx-hero{ padding:150px 0 0; }
.sx-hero-grid{ display:grid; grid-template-columns:minmax(0,1.55fr) minmax(0,.7fr); gap:56px; align-items:center; }
.sx-hero h1{ font-size:clamp(32px,4.8vw,58px); line-height:1.12; margin:0; }
.sx-lede{ margin:22px 0 0; max-width:52ch; font-size:20px; line-height:1.6; color:var(--text-dim); }
.sx-badges{ display:flex; flex-wrap:wrap; gap:8px; margin:26px 0 0; padding:0; list-style:none; }
.sx-badges li{ padding:7px 13px; border:1px solid var(--border); border-radius:999px; background:rgba(255,255,255,.025); font-size:13px; color:var(--text); }
.sx-portrait{ margin:0; position:relative; }
.sx-portrait::before{ content:""; position:absolute; inset:-18px; border-radius:36px; background:radial-gradient(60% 60% at 50% 40%,rgba(217,172,84,.22),transparent 70%); z-index:0; }
.sx-portrait img{ position:relative; z-index:1; width:100%; max-width:340px; margin:0 0 0 auto; aspect-ratio:3/4; object-fit:cover; border-radius:28px; border:1px solid rgba(217,172,84,.35); box-shadow:var(--shadow-pop); }
.sx-statbar{ display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:0; margin-top:72px; padding:0 32px; list-style:none; border-top:1px solid var(--border); }
.sx-statbar li{ padding:26px 24px 30px 0; }
.sx-statbar li + li{ padding-left:24px; border-left:1px solid var(--border-soft); }
.sx-statbar b{ display:block; font:600 clamp(30px,3.6vw,44px)/1 Cinzel,Georgia,serif; color:var(--gold-bright); }
.sx-statbar span{ display:block; margin-top:8px; font-size:13.5px; color:var(--text-dim); }

/* ---------- Project cards (reuse the long-card style) ---------- */
.sx-projects{ display:grid; gap:16px; }
.sx-projects .workspace-card{ transition:transform .2s ease,border-color .2s ease; }
.sx-projects .workspace-card:hover{ transform:translateY(-3px); border-color:var(--gold-dim); }

/* ---------- Experience ---------- */
.sx-exp{ display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; margin-top:36px; }
.sx-exp-card{ padding:28px; border:1px solid var(--border); border-radius:var(--radius); background:var(--card); box-shadow:var(--shadow-card); }
.sx-exp-card header{ margin-bottom:18px; padding-bottom:16px; border-bottom:1px solid var(--border-soft); }
.sx-exp-card h3{ font-size:24px; font-family:Cinzel,Georgia,serif; }
.sx-exp-card header p{ margin:6px 0 0; color:var(--gold); font-size:13.5px; font-weight:500; }
.sx-exp-card .hero-bullets{ font-size:15.5px; line-height:1.55; color:var(--text); }

/* ---------- Process / skills visuals ---------- */
#process .hero-flow,#skills .hero-flow{ margin-top:34px; }
#process .hero-map li{ background:var(--card); }
.sx-section .hero-flow-tools{ margin-top:22px; color:var(--text-dim); font-size:15px; }

/* ---------- About / contact ---------- */
.sx-about{ display:grid; grid-template-columns:minmax(0,1.2fr) minmax(0,1fr); gap:56px; }
.sx-about .hero-edu{ grid-template-columns:1fr; margin-top:14px; }
.sx-contact{ padding-bottom:110px; }
.sx-contact h2{ max-width:none; }
.sx-footer{ display:flex; justify-content:space-between; gap:16px; padding-top:26px; padding-bottom:40px; border-top:1px solid var(--border-soft); color:var(--text-faint); font-size:13.5px; }
.sx-footer div{ display:flex; gap:18px; }
.sx-footer a:hover{ color:var(--gold); }

/* ---------- Reveal on scroll ---------- */
.js .sx-reveal{ opacity:0; transform:translateY(18px); transition:opacity .6s ease,transform .6s ease; }
.js .sx-reveal.is-in{ opacity:1; transform:none; }
@media (prefers-reduced-motion:reduce){ .js .sx-reveal{ opacity:1; transform:none; transition:none; } }

/* ============================================================
   Case study pages
   ============================================================ */
.sx-case{ --accent:var(--gold); }
.sx-case[data-accent="secureid"]{ --accent:var(--secureid); }
.sx-case[data-accent="honda"]{ --accent:var(--honda); }
.sx-case[data-accent="devtective"]{ --accent:var(--devtective); }
.sx-case[data-accent="vextaro"]{ --accent:var(--vextaro); }
.sx-case[data-accent="studybuddy"]{ --accent:var(--studybuddy); }
.sx-progress{ position:fixed; top:0; left:0; height:3px; width:0; z-index:150; background:var(--accent); }
.sx-main{ display:block; padding-top:112px; }
.sx-case .cs-hero{ max-width:1180px; margin:0 auto; padding:0 32px 8px; border:0; background:none; }
.sx-case .cs-hero::before{ content:none; }
.sx-case .breadcrumb{ margin-bottom:22px; }
.sx-case .cs-hero h1{ font-size:clamp(36px,5.6vw,64px); line-height:1.08; margin:0 0 16px; }
.sx-case .cs-hero .tagline{ max-width:60ch; font-size:20px; line-height:1.6; }
.sx-case .cs-badge-row span{ border-color:var(--accent); color:var(--accent); }
.sx-case .cs-glance{ max-width:760px; }
.sx-case .impact-stat .n{ color:var(--accent); }
.sx-case .cs-meta{ margin-top:30px; padding:22px 0 0; border-top:1px solid var(--border); border-radius:0; background:none; display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:20px; }
.sx-cover{ margin:36px 0 0; border:1px solid var(--border); border-radius:var(--radius); overflow:hidden; background:var(--card); }
.sx-cover img{ width:100%; height:auto; max-height:640px; object-fit:cover; }
.sx-case .cs-body{ max-width:1180px; margin:0 auto; padding:40px 32px 24px; counter-reset:sec; }
.sx-case .cs-section{ counter-increment:sec; max-width:none; margin:0 0 76px; padding-top:44px; border-top:1px solid var(--border); }
.sx-case .cs-section > h2{ max-width:30ch; font-size:clamp(24px,3vw,34px); line-height:1.2; margin-bottom:18px; }
.sx-case .cs-section > h2::before,.sx-case .cs-split-text > h2::before{ content:"0" counter(sec); display:block; margin-bottom:12px; font:600 12px/1 'Inter',sans-serif; letter-spacing:.16em; text-transform:uppercase; color:var(--accent); }
.sx-case .cs-section p,.sx-case .cs-section > ul{ max-width:68ch; }
.sx-case .cs-split-text > h2{ font-size:clamp(24px,3vw,34px); line-height:1.2; margin-bottom:16px; }
.sx-case .cs-nav-footer{ display:flex; justify-content:space-between; gap:14px; margin:20px 0 0; padding:28px 0 0; border-top:1px solid var(--border); }
.sx-case .cs-nav-footer a{ padding:14px 20px; border:1px solid var(--border); border-radius:var(--radius-sm); background:var(--card); color:var(--text); font-weight:600; transition:border-color .18s ease,transform .18s ease; }
.sx-case .cs-nav-footer a:hover{ border-color:var(--accent); color:var(--gold-bright); transform:translateY(-2px); }
.sx-case > footer.container{ margin-top:56px!important; padding-bottom:40px; }
.sx-rail{ position:fixed; right:18px; top:50%; transform:translateY(-50%); z-index:90; display:none; flex-direction:column; gap:6px; }
.sx-rail a{ position:relative; display:block; width:12px; height:12px; }
.sx-rail a::before{ content:""; position:absolute; inset:3px; border-radius:50%; background:var(--border); transition:background-color .2s ease,transform .2s ease; }
.sx-rail a:hover::before,.sx-rail a.is-active::before{ background:var(--accent); transform:scale(1.5); }
.sx-rail a span{ position:absolute; right:22px; top:50%; transform:translateY(-50%); padding:5px 10px; border-radius:6px; background:rgba(18,15,11,.9); border:1px solid var(--border); font-size:12px; color:var(--text); white-space:nowrap; opacity:0; pointer-events:none; transition:opacity .15s ease; }
.sx-rail a:hover span,.sx-rail a:focus-visible span{ opacity:1; }
@media (min-width:1280px){ .sx-rail{ display:flex; } }

/* ---------- Responsive ---------- */
@media (max-width:900px){
  .sx-hero-grid{ grid-template-columns:1fr; gap:36px; }
  .sx-portrait{ order:-1; max-width:200px; }
  .sx-portrait img{ margin:0; max-width:200px; }
  .sx-statbar{ grid-template-columns:repeat(2,minmax(0,1fr)); }
  .sx-statbar li:nth-child(3){ padding-left:0; border-left:0; }
  .sx-statbar li:nth-child(n+3){ border-top:1px solid var(--border-soft); }
  .sx-exp,.sx-about{ grid-template-columns:1fr; gap:32px; }
  .sx-case .cs-meta{ grid-template-columns:repeat(2,minmax(0,1fr)); }
}
@media (max-width:700px){
  .sx-wrap,.sx-case .cs-hero,.sx-case .cs-body{ padding-left:18px; padding-right:18px; }
  .sx-statbar{ padding:0 18px; }
  .sx-hero{ padding-top:112px; }
  .sx-section{ padding:64px 0; }
  .sx-nav{ gap:0; padding:5px 6px; max-width:100%; overflow-x:auto; scrollbar-width:none; }
  .sx-nav::-webkit-scrollbar{ display:none; }
  .sx-nav a{ padding:8px 10px; font-size:13px; }
  .sx-brand span,.sx-status span,.sx-nav-sep{ display:none; }
  .sx-nav .sx-brand{ padding:3px 6px 3px 3px; }
  .sx-status{ padding:0 8px; }
  .sx-case .cs-nav-footer{ flex-direction:column; }
  .sx-footer{ flex-direction:column; }
}
.sx-portrait img{ height:auto; }

/* ============================================================
   Old design system (workspace look): neutral panels, Cinzel + Raleway,
   workspace gold, 4px-radius buttons. Project accent colors unchanged.
   ============================================================ */
.sx-page{
  --bg:#080808; --bg-raised:#111; --panel:#111; --card:#151515; --card-hover:#1a1a1a;
  --border:#292929; --border-soft:#202020;
  --text:#f0ede8; --text-dim:#aaa39b; --text-faint:#8d877f;
  --gold:#c9a84c; --gold-bright:#e0bf62; --gold-dim:#8d7634;
  background:#080808; color:var(--text); font-family:'Raleway',Inter,sans-serif;
}
.sx-page h1,.sx-page h2,.sx-page h3{ font-family:Cinzel,Georgia,serif; color:#f0ede8; letter-spacing:.01em; }
.sx-page .sx-kicker{ font-family:'Raleway',sans-serif; letter-spacing:.18em; }
.sx-nav{ background:rgba(17,17,17,.62); border-color:rgba(201,168,76,.3); }
.sx-nav .sx-brand{ font-family:Cinzel,Georgia,serif; font-size:14px; letter-spacing:.08em; text-transform:uppercase; }
.sx-nav a,.sx-status{ font-family:'Raleway',sans-serif; }
.sx-nav a.is-active{ background:rgba(201,168,76,.16); }
.sx-badges li{ border-color:#2b2b2b; border-radius:4px; background:#111; font-family:'Raleway',sans-serif; }
.sx-lede,.sx-sub{ font-family:'Raleway',sans-serif; }
.sx-portrait::before{ background:radial-gradient(60% 60% at 50% 40%,rgba(201,168,76,.18),transparent 70%); }
.sx-portrait img{ border-radius:12px; border-color:#343434; }
.sx-statbar b{ font-family:Cinzel,Georgia,serif; color:var(--gold); font-weight:600; }
.sx-exp-card{ background:#111; border-color:#292929; border-radius:10px; box-shadow:none; }
.sx-exp-card:hover{ border-color:#8d7634; }
.sx-exp-card header p{ color:var(--gold); }
.sx-exp-card h3{ font-family:Cinzel,Georgia,serif; font-size:20px; }
.sx-case .cs-nav-footer a,.sx-case .cs-section figure img{ border-radius:8px; }

/* Buttons: same as the Share / Contact buttons (gold, 4px radius, lift + glow on hover) */
.sx-btn{ display:inline-flex; align-items:center; gap:8px; padding:11px 20px; border:1px solid var(--gold); border-radius:999px; background:transparent; color:var(--gold); font:700 14px/1 'Raleway',sans-serif; cursor:pointer; transition:transform .18s ease,box-shadow .18s ease,background-color .18s ease,color .18s ease; }
.sx-btn:hover,.sx-btn:focus-visible{ transform:translateY(-3px) scale(1.04); background:rgba(201,168,76,.14); color:#f0cf74; box-shadow:0 6px 18px rgba(201,168,76,.45),0 0 0 2px rgba(240,207,116,.35); }
.sx-btn:active{ transform:none; box-shadow:none; }
.sx-btn-primary{ background:var(--gold); color:#111; }
.sx-btn-primary:hover,.sx-btn-primary:focus-visible{ background:#f0cf74; color:#111; }
@media (prefers-reduced-motion:reduce){ .sx-btn{ transition:none; } .sx-btn:hover{ transform:none; } }


.sx-hero .sx-cta{ gap:12px; }
.hw-nav{ display:inline-flex; align-items:center; gap:6px; }
.hw-nav img{ width:14px; height:16px; }

/* --- v3.1: stacked hero stats, breadcrumb colors, text stats --- */
.sx-statbar li.is-text b{ font-size:clamp(20px,2.2vw,27px); line-height:1.15; }
.sx-statbar li.is-text span{ max-width:26ch; }
.sx-case .breadcrumb{ color:#8a857b; }
.sx-case .breadcrumb a{ color:#f0ede8; text-decoration:none; }
.sx-case .breadcrumb a:hover{ color:var(--gold-bright); text-decoration:underline; text-underline-offset:3px; }
.sx-case .cs-hero{ display:grid; grid-template-columns:minmax(0,1fr) 270px; column-gap:48px; grid-template-areas:"crumb crumb" "title glance" "tag glance" "badge glance" "meta meta" "cover cover"; align-items:start; }
.sx-case .cs-hero .breadcrumb{ grid-area:crumb; }
.sx-case .cs-hero h1{ grid-area:title; }
.sx-case .cs-hero .tagline{ grid-area:tag; }
.sx-case .cs-hero .cs-glance{ grid-area:glance; max-width:none; grid-template-columns:1fr; gap:12px; margin:0; align-self:start; }
.sx-case .cs-hero .cs-badge-row{ grid-area:badge; }
.sx-case .cs-hero .cs-meta{ grid-area:meta; }
.sx-case .cs-hero .sx-cover{ grid-area:cover; }
@media (max-width:860px){
  .sx-case .cs-hero{ display:block; }
  .sx-case .cs-hero .cs-glance{ grid-template-columns:1fr; margin:22px 0 0; }
}
.sx-nav{ gap:2px; }

/* personas */
.persona-grid{ display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; margin-top:22px; }
.persona{ border:1px solid var(--border); border-radius:var(--radius); background:var(--card); padding:20px; display:flex; flex-direction:column; gap:14px; }
.persona header{ display:flex; gap:14px; align-items:center; }
.persona-av{ flex:none; width:46px; height:46px; border-radius:50%; display:grid; place-items:center; font:600 20px Cinzel,Georgia,serif; color:#17130b; background:var(--accent,var(--gold)); }
.persona-analyst .persona-av{ background:transparent; color:var(--accent,var(--gold)); border:2px solid var(--accent,var(--gold)); }
.persona h3{ margin:0; font:600 20px Cinzel,Georgia,serif; color:var(--text); }
.persona header p{ margin:2px 0 0; font-size:13.5px; color:var(--text); }
.persona header em{ font-style:normal; color:#8a857b; }
.persona-about{ margin:0; font-size:14px; line-height:1.55; color:var(--text-dim); }
.persona-about span{ display:block; margin-top:6px; font-size:12.5px; color:#8a857b; }
.persona-cols{ display:grid; grid-template-columns:1fr 1fr; gap:14px; }
.persona h4{ margin:0 0 6px; font:700 11px Raleway,sans-serif; letter-spacing:.12em; text-transform:uppercase; color:var(--accent,var(--gold)); }
.persona ul{ margin:0; padding-left:16px; font-size:13px; line-height:1.5; color:var(--text-dim); }
.persona li{ margin-bottom:3px; }
.persona-goal{ margin:auto 0 0; padding-top:12px; border-top:1px solid var(--border-soft); font-size:13.5px; line-height:1.5; color:var(--text); }
.persona-goal b{ display:block; margin-bottom:2px; font:700 11px Raleway,sans-serif; letter-spacing:.12em; text-transform:uppercase; color:var(--accent,var(--gold)); }
@media (max-width:860px){ .persona-grid{ grid-template-columns:1fr; } }
@media (max-width:480px){ .persona-cols{ grid-template-columns:1fr; } }


/* ============================================================
   MOTION DESIGN PRINCIPLES (Motion/Framer Motion Inspired)
   Strictly preserving original layouts, typography, and styling.
   ============================================================ */

:root {
  /* Motion standard snappy deceleration & spring curves */
  --ease-motion: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-motion-soft: cubic-bezier(0.25, 1, 0.5, 1);
  --ease-motion-spring: cubic-bezier(0.34, 1.3, 0.64, 1);
}

/* Buttery smooth page scrolling with fixed header offset */
html {
  scroll-behavior: smooth !important;
  scroll-padding-top: 88px;
}
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto !important; }
}

/* Motion-style smooth section reveals on scroll */
.sx-reveal {
  opacity: 0;
  transform: translateY(22px);
  transition: opacity 0.65s var(--ease-motion), transform 0.65s var(--ease-motion);
  will-change: opacity, transform;
}
.sx-reveal.is-in {
  opacity: 1;
  transform: translateY(0);
}

/* ------------------------------------------------------------
   NAVIGATION: Frosted pill hover with Motion micro-interactions
   ------------------------------------------------------------ */
.sx-nav a {
  transition: background-color 0.24s var(--ease-motion),
              color 0.24s var(--ease-motion),
              transform 0.24s var(--ease-motion);
}
.sx-nav a:hover,
.sx-nav a:focus-visible {
  color: var(--text) !important;
  background: rgba(255, 255, 255, 0.09) !important;
  transform: translateY(-1px);
}
/* Tactile Motion whileTap physical feedback */
.sx-nav a:active {
  transform: scale(0.96);
}
.sx-nav a.is-active {
  color: var(--gold-bright) !important;
  background: rgba(217, 172, 84, 0.16) !important;
}

/* ------------------------------------------------------------
   MOBILE NAVIGATION: Generous Spacing for Profile & De La Paz
   ------------------------------------------------------------ */
@media (max-width: 700px) {
  .sx-nav {
    display: inline-flex !important;
    align-items: center !important;
    gap: 4px !important;
    padding: 5px 8px !important;
    max-width: 96vw !important;
    overflow-x: auto !important;
    -webkit-overflow-scrolling: touch !important;
  }
  /* Avatar + "DE LA PAZ" button */
  .sx-nav .sx-brand {
    display: inline-flex !important;
    align-items: center !important;
    gap: 8px !important;
    padding: 4px 10px 4px 5px !important;
    margin-right: 6px !important;
    flex-shrink: 0 !important;
    transition: opacity 0.2s var(--ease-motion), transform 0.2s var(--ease-motion);
  }
  .sx-nav .sx-brand:active {
    transform: scale(0.96);
  }
  .sx-nav .sx-brand img {
    display: block !important;
    width: 26px !important;
    height: 26px !important;
    border-radius: 50% !important;
    object-fit: cover !important;
    border: 1px solid var(--gold-dim) !important;
    flex-shrink: 0 !important;
  }
  .sx-nav .sx-brand span {
    display: inline-block !important;
    font-family: Cinzel, Georgia, serif !important;
    font-size: 13px !important;
    font-weight: 600 !important;
    letter-spacing: 0.08em !important;
    text-transform: uppercase !important;
    color: var(--text) !important;
    white-space: nowrap !important;
  }
  /* Elegant divider between "DE LA PAZ" and "Work" nav button */
  .sx-nav .sx-brand + .sx-nav-sep,
  .sx-nav > .sx-nav-sep:first-of-type {
    display: block !important;
    width: 1px !important;
    height: 18px !important;
    margin: 0 8px 0 2px !important;
    background: rgba(255, 255, 255, 0.16) !important;
    flex-shrink: 0 !important;
  }
  .sx-nav a {
    padding: 5px 11px !important;
    font-size: 13px !important;
    white-space: nowrap !important;
    flex-shrink: 0 !important;
  }
}

/* ------------------------------------------------------------
   WORK SECTION CARDS: PRESERVE EXACT DESKTOP/MOBILE LAYOUT
   Desktop: Horizontal (180px 1fr) via .project-grid.is-list
   Mobile: Square-ish vertical cards
   Hover: Dynamic card elevation & project-colored tags
   ------------------------------------------------------------ */
.project-grid .workspace-card,
.sx-projects .workspace-card {
  transition: transform 0.28s var(--ease-motion),
              border-color 0.28s var(--ease-motion),
              box-shadow 0.28s var(--ease-motion);
}
.project-grid .workspace-card:hover,
.sx-projects .workspace-card:hover {
  transform: translateY(-3px);
}
.project-grid .workspace-card:active,
.sx-projects .workspace-card:active {
  transform: translateY(-1px) scale(0.995);
}

/* Base tag transitions */
.project-grid .workspace-card .card-tags span,
.sx-projects .workspace-card .card-tags span {
  transition: background-color 0.28s var(--ease-motion),
              border-color 0.28s var(--ease-motion),
              color 0.28s var(--ease-motion);
}

/* 1. Study Buddy: Purple (#a594f9) */
.project-grid .workspace-card.card-studybuddy:hover,
.sx-projects .workspace-card.card-studybuddy:hover {
  border-color: #a594f9 !important;
  box-shadow: 0 8px 28px -4px rgba(165, 148, 249, 0.32) !important;
}
.project-grid .workspace-card.card-studybuddy:hover .card-role,
.project-grid .workspace-card.card-studybuddy:hover .card-outcome b {
  color: #a594f9 !important;
}
.project-grid .workspace-card.card-studybuddy:hover .card-tags span,
.sx-projects .workspace-card.card-studybuddy:hover .card-tags span {
  background: rgba(165, 148, 249, 0.12) !important;
  border-color: rgba(165, 148, 249, 0.45) !important;
  color: #e2dcff !important;
}
.project-grid .workspace-card.card-studybuddy:hover .card-tags span:first-child,
.sx-projects .workspace-card.card-studybuddy:hover .card-tags span:first-child {
  background: rgba(165, 148, 249, 0.24) !important;
  border-color: #a594f9 !important;
  color: #ffffff !important;
}

/* 2. SecureID: Gold (#d9ac54) */
.project-grid .workspace-card.card-secureid:hover,
.sx-projects .workspace-card.card-secureid:hover {
  border-color: #d9ac54 !important;
  box-shadow: 0 8px 28px -4px rgba(217, 172, 84, 0.32) !important;
}
.project-grid .workspace-card.card-secureid:hover .card-role,
.project-grid .workspace-card.card-secureid:hover .card-outcome b {
  color: #f0c878 !important;
}
.project-grid .workspace-card.card-secureid:hover .card-tags span,
.sx-projects .workspace-card.card-secureid:hover .card-tags span {
  background: rgba(217, 172, 84, 0.12) !important;
  border-color: rgba(217, 172, 84, 0.45) !important;
  color: #f6ebd2 !important;
}
.project-grid .workspace-card.card-secureid:hover .card-tags span:first-child,
.sx-projects .workspace-card.card-secureid:hover .card-tags span:first-child {
  background: rgba(217, 172, 84, 0.24) !important;
  border-color: #d9ac54 !important;
  color: #ffffff !important;
}

/* 3. Vextaro: Blue / Cyan (#5aa3c9) */
.project-grid .workspace-card.card-vextaro:hover,
.sx-projects .workspace-card.card-vextaro:hover {
  border-color: #5aa3c9 !important;
  box-shadow: 0 8px 28px -4px rgba(90, 163, 201, 0.32) !important;
}
.project-grid .workspace-card.card-vextaro:hover .card-role,
.project-grid .workspace-card.card-vextaro:hover .card-outcome b {
